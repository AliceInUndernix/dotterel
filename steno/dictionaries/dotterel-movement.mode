option	exclude_entry	no
option	exit_on_mismatch	yes
option	exit_on_match	no
option	ignore_folding	yes
entry	{#Left}{^}	#TPH-F STPH-F
entry	{#Shift_l(Left)}{^}	#TPH*F STPH*F
entry	{#Down}{^}	#TPH-P STPH-P
entry	{#Shift_l(Down)}{^}	#TPH*P STPH*P
entry	{#Up}{^}	#TPH-L STPH-L
entry	{#Shift_l(Up)}{^}	#TPH*L STPH*L
entry	{#Right}{^}	#TPH-T
entry	{#Shift_l(Right)}{^}	#TPH*T STPH*T
entry	{#Control_l(Left)}{^}	#TPH-R STPH-R
entry	{#Control_l(Shift_l(Left))}{^}	#TPH*R STPH*R
entry	{#Page_Down}{^}	#TPH-B STPH-B
entry	{#Shift_l(Page_Down)}{^}	#TPH*B STPH*B
entry	{#Page_Up}{^}	#TPH-G STPH-G
entry	{#Shift_l(Page_Up)}{^}	#TPH*G STPH*G
entry	{#Control_l(Right)}{^}	#TPH-S
entry	{#Control_l(Shift_l(Right))}{^}	#TPH*S STPH*S
entry	{#Home}{^}	#TPH-FR STPH-FR
entry	{#Shift_l(Home)}{^}	#TPH*FR STPH*FR
entry	{#End}{^}	#TPH-TS
entry	{#Shift_l(End)}{^}	#TPH*TS STPH*TS
entry	{#Control_l(Home)}{^}	#TPH-LG STPH-LG
entry	{#Control_l(Shift_l(Home))}{^}	#TPH*LG STPH*LG
entry	{#Control_l(End)}{^}	#TPH-PB STPH-PB
entry	{#Control_l(Shift_l(End))}{^}	#TPH*PB STPH*PB
dict	{#Left}{^}	-F
dict	{#Shift_l(Left)}{^}	*F
dict	{#Down}{^}	-P
dict	{#Shift_l(Down)}{^}	*P
dict	{#Up}{^}	-L
dict	{#Shift_l(Up)}{^}	*L
dict	{#Right}{^}	-T
dict	{#Shift_l(Right)}{^}	*T
dict	{#Control_l(Left)}{^}	-R
dict	{#Control_l(Shift_l(Left))}{^}	*R
dict	{#Page_Down}{^}	-B
dict	{#Shift_l(Page_Down)}{^}	*B
dict	{#Page_Up}{^}	-G
dict	{#Shift_l(Page_Up)}{^}	*G
dict	{#Control_l(Right)}{^}	-S
dict	{#Control_l(Shift_l(Right))}{^}	*S
dict	{#Home}{^}	-FR
dict	{#Shift_l(Home)}{^}	*FR
dict	{#End}{^}	-TS
dict	{#Shift_l(End)}{^}	*TS
dict	{#Control_l(Home)}{^}	-LG
dict	{#Control_l(Shift_l(Home))}{^}	*LG
dict	{#Control_l(End)}{^}	-PB
dict	{#Control_l(Shift_l(End))}{^}	*PB
